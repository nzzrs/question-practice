{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nzrs.link/question-practice/import.schema.json",
  "title": "Question Practice import",
  "description": "Practice file accepted by the Question Practice Android app.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "topics"],
  "properties": {
    "formatVersion": {
      "const": 1,
      "description": "Format version. Only version 1 is accepted."
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/definitions/topic" }
    }
  },
  "definitions": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "practices"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "priority": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "practices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/practice" }
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "questions"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/question" }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "alternatives",
        "correctIndex",
        "explanation",
        "alternativeExplanations"
      ],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "correctIndex": { "type": "integer", "minimum": 0, "maximum": 7 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "alternativeExplanations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 5000 }
        }
      }
    }
  }
}
