#!/usr/bin/env sh
# Git runs this before every push. The build happens on this laptop, so the
# pushed commit is never published without a matching debug APK.
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# The database reference is generated from the Drift schema. Refuse to push
# documentation that no longer matches the code.
dart run tool/docs/update_docs.dart --check

exec "$repo_root/tool/build_debug_apk.sh"
